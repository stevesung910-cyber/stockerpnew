DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/stockerp?schema=public"
DATABASE_URL_MIGRATION="postgresql://YOUR_MIGRATION_USER:YOUR_MIGRATION_PASSWORD@localhost:5432/stockerp?schema=public"
SHADOW_DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/stockerp_shadow?schema=public"
DATABASE_URL_TEST="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/stockerp_test?schema=public"
APP_ENV=development
NODE_ENV=development
AUTH_DEV_EXPOSE_TOKENS=false
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
# Generate a unique random 32-byte secret encoded as 64 hex characters.
OWNER_REGISTRATION_OTP_HMAC_SECRET=
# Optional comma-separated trusted reverse proxy IPs or CIDRs.
TRUSTED_PROXY_NETWORKS=

# smtp uses Gmail STARTTLS. Set the App Password privately in .env.
EMAIL_DELIVERY_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=stephensunrise@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=stephensunrise@gmail.com
REGISTRATION_OWNER_EMAIL=stephensunrise@gmail.com

# The following settings apply only to the optional google-gmail OAuth provider.
# Existing active, mailbox-verified StockERP user ID, assigned by a deployment operator.
SOFTWARE_OWNER_USER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact public backend callback URI registered on the Google OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=
# Must match REGISTRATION_OWNER_EMAIL when Gmail delivery is enabled.
GOOGLE_GMAIL_SENDER_EMAIL=
# Separate random 32-byte key encoded as 64 hex characters.
GOOGLE_OAUTH_ENCRYPTION_KEY=
